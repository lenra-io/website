- const headerClass = "invert-colors"
header(class=headerClass)
    - const homePage = pageList.find(p => p.name === 'index')
    - const navPages = pageList.filter(p => !p.notOnTop && p.name !== 'contact')
    - const contactPage = pageList.find(p => p.name === 'contact')
    nav.menu
        div.brand
            - const homePath = (homePage && homePage.path) ? homePage.path : '/'
            a.logo(href=homePath) Lenra
            if currentPage.badge
                span.badge= currentPage.badge
        if navPages.length
            ul.links
                each p in navPages
                    - const trad = page[p.name]
                    - const path = p.path || `/${p.name}.html`
                    li
                        if p.disabled
                            a(href=path disabled aria-disabled="true" tabindex="-1" title="Bientôt disponible")= trad.name
                        else if p.name === currentPage.basicPath
                            a.current(href=path)= trad.name
                        else
                            a(href=path)= trad.name
        if contactPage
            - const contactTrad = page[contactPage.name]
            - const contactPath = contactPage.path || `/${contactPage.name}.html`
            if contactPage.name === currentPage.basicPath
                a.btn.primary.contact(href=contactPath)= contactTrad.name
            else
                a.btn.contact(href=contactPath)= contactTrad.name

    block header
        h1 !{currentPage.titleHtml || currentPage.title || currentPage.name}
        if currentPage.subtitle
            h2 !{currentPage.subtitle}
        if currentPage.headerTexts
            each text  in currentPage.headerTexts
                p= text
        if currentPage.mainAction
            a.btn.primary(href=currentPage.mainAction.href)= currentPage.mainAction.text